{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evb-viewer.dev/schemas/electron-e2e-quarantine-graduation-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "lane",
    "operatorDiagnostics",
    "tests"
  ],
  "properties": {
    "$schema": {
      "const": "./graduation-policy.schema.json"
    },
    "version": {
      "const": 2
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "events",
        "blocking",
        "infraRetryCount",
        "reviewAfterScheduledRuns",
        "graduationEvidence"
      ],
      "properties": {
        "events": {
          "const": [
            "schedule",
            "workflow_dispatch"
          ]
        },
        "blocking": {
          "const": false
        },
        "infraRetryCount": {
          "const": 2
        },
        "reviewAfterScheduledRuns": {
          "const": 30
        },
        "graduationEvidence": {
          "const": "github-actions-scheduled-history-and-manual-review"
        }
      }
    },
    "operatorDiagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^tests/e2e/electron/quarantine/.+\\.e2e\\.test\\.ts$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "targetProject"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^tests/e2e/electron/quarantine/.+\\.e2e\\.test\\.ts$"
          },
          "targetProject": {
            "enum": [
              "e2e-regression",
              "e2e-blocking-smoke"
            ]
          }
        }
      }
    }
  }
}
