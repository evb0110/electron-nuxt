{
  "name": "evb-viewer",
  "productName": "EVB Viewer",
  "version": "0.1.241",
  "author": "Eugene Barsky <34789976+evb0110@users.noreply.github.com>",
  "description": "EVB Viewer — a PDF and DjVu document viewer",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "main": "dist-electron/main.cjs",
  "scripts": {
    "start": "pnpm run build:electron && tsx scripts/electron-run.ts start",
    "dev": "pnpm electron:run stop --session=default --keep-nuxt && pnpm run build:electron && tsx scripts/electron-run.ts start",
    "dev:nuxt": "pnpm exec nuxi dev --host 127.0.0.1",
    "dev:nuxt:vm": "pnpm exec nuxi dev --host 0.0.0.0 --port 3235",
    "dev:web": "pnpm exec nuxi dev --host 127.0.0.1 --port 3235",
    "build": "pnpm exec nuxi build",
    "build:desktop": "pnpm run build && pnpm run build:electron",
    "build:strict": "node scripts/run-build-strict.mjs",
    "build:icons": "bash scripts/build-icons.sh",
    "build:electron": "node scripts/build-electron.mjs",
    "preview": "pnpm exec nuxi preview",
    "postinstall": "pnpm exec nuxi prepare && pnpm run copy:pdfjs",
    "copy:pdfjs": "node scripts/copy-pdfjs-assets.mjs && node scripts/sync-pdfjs-viewer-css.mjs",
    "typecheck": "pnpm run typecheck:app && pnpm run typecheck:electron && pnpm run typecheck:tests && pnpm run typecheck:scripts && pnpm run typecheck:packages",
    "typecheck:app": "node scripts/run-nuxt-typecheck.mjs",
    "typecheck:electron": "tsc -p electron/tsconfig.json",
    "typecheck:tests": "tsc -p tests/tsconfig.json",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "typecheck:packages": "tsc -p packages/contracts/tsconfig.json && tsc -p packages/i18n-core/tsconfig.json && tsc -p packages/i18n-app/tsconfig.json && tsc -p packages/release-selection/tsconfig.json",
    "lint": "eslint . --max-warnings=0 --report-unused-disable-directives && stylelint \"app/**/*.{vue,scss,css}\" && pnpm run check:locales && pnpm run check:icons:bundle && pnpm run check:commonjs-imports",
    "lint:fix": "eslint . --fix --max-warnings=0 && stylelint \"app/**/*.{vue,scss,css}\" && pnpm run check:locales && pnpm run check:icons:bundle && pnpm run check:commonjs-imports",
    "fallow": "fallow dead-code",
    "fallow:all": "pnpm run fallow && pnpm run fallow:dupes && pnpm run fallow:health",
    "fallow:changed": "fallow dead-code --changed-since origin/main",
    "fallow:dupes": "fallow dupes --production --threshold 10 --fail-on-issues --summary",
    "fallow:health": "fallow health --summary || true",
    "typecheck:coverage": "node --max-old-space-size=8192 node_modules/type-coverage/bin/type-coverage --config .typecoveragerc.json",
    "validate": "pnpm run lint && pnpm run typecheck && pnpm run typecheck:coverage && pnpm run build:strict && pnpm run fallow:all && pnpm run check:architecture",
    "test": "vitest run",
    "test:release": "pnpm test",
    "test:bundle-integrity": "vitest run --config vitest.bundle-integrity.config.ts",
    "test:smoke": "pnpm run test:release && pnpm run test:e2e:electron",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e:electron": "pnpm run build:electron && pnpm run test:e2e:electron:smoke:no-build",
    "test:e2e:electron:large": "EVB_E2E_LARGE_PDF=1 pnpm run build:electron && EVB_E2E_LARGE_PDF=1 pnpm exec vitest run --config vitest.electron-e2e.smoke.config.ts tests/e2e/electron/phase1.large-pdf-annotation-save.e2e.test.ts",
    "test:e2e:electron:smoke:no-build": "vitest run --config vitest.electron-e2e.smoke.config.ts",
    "test:e2e:electron:watch": "vitest --config vitest.electron-e2e.smoke.config.ts",
    "electron:run": "tsx scripts/electron-run.ts",
    "dist": "pnpm run build:desktop && electron-builder",
    "dist:mac": "pnpm run build:desktop && electron-builder --mac",
    "dist:win": "pnpm run build:desktop && electron-builder --win",
    "dist:linux": "pnpm run build:desktop && electron-builder --linux",
    "release:verify:checks": "node scripts/release/verify-local-checks.mjs",
    "release:verify:package:local": "node scripts/release/verify-local-package.mjs",
    "release:verify": "pnpm run release:verify:checks && pnpm run release:verify:package:local && pnpm run check:resources:host",
    "release:patch": "HUSKY=0 node scripts/release/cut-release.mjs patch",
    "release:minor": "HUSKY=0 node scripts/release/cut-release.mjs minor",
    "release:major": "HUSKY=0 node scripts/release/cut-release.mjs major",
    "check:resources:host": "bash scripts/check-native-tools-source-matrix.sh",
    "check:resources:matrix": "bash scripts/check-native-tools-source-matrix.sh --all",
    "check:electron:install": "node scripts/check-electron-install.mjs",
    "check:locales": "pnpm exec tsx scripts/check-locales.ts",
    "check:icons:bundle": "pnpm exec tsx scripts/check-icon-bundle.ts",
    "check:commonjs-imports": "pnpm exec tsx scripts/check-commonjs-imports.ts",
    "check:architecture:dep-graph": "node scripts/architecture/dep-graph.mjs --output=.tmp/dep-graph.json",
    "check:architecture:boundaries": "node scripts/architecture/boundary-check.mjs",
    "check:architecture": "pnpm run check:architecture:dep-graph && pnpm run check:architecture:boundaries",
    "preversion": "pnpm run check:resources:matrix",
    "gate:commit": "pnpm exec lint-staged",
    "gate:pre-release": "pnpm run validate && pnpm run test:smoke && pnpm run test:bundle-integrity",
    "prepare": "husky"
  },
  "lint-staged": {
    "!(*.config).{ts,mts,vue}": "eslint --fix --max-warnings=0 --no-warn-ignored",
    "app/**/*.{vue,scss,css}": "stylelint --fix"
  },
  "dependencies": {
    "@babel/parser": "7.29.2",
    "@iconify/utils": "3.1.1",
    "@intlify/core": "11.4.0",
    "@intlify/core-base": "11.4.0",
    "@intlify/h3": "0.7.4",
    "@intlify/message-compiler": "11.4.0",
    "@intlify/shared": "11.4.0",
    "@intlify/utils": "0.13.0",
    "@neondatabase/serverless": "^1.1.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@vue/compiler-core": "3.5.33",
    "@vue/compiler-dom": "3.5.33",
    "@vue/compiler-ssr": "3.5.33",
    "@vue/devtools-api": "6.6.4",
    "@vue/reactivity": "3.5.33",
    "@vue/runtime-core": "3.5.33",
    "@vue/runtime-dom": "3.5.33",
    "@vue/server-renderer": "3.5.33",
    "@vue/shared": "3.5.33",
    "consola": "3.4.2",
    "cookie-es": "2.0.0",
    "defu": "6.1.7",
    "destr": "2.0.5",
    "devalue": "5.7.1",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.3",
    "entities": "7.0.1",
    "estree-walker": "3.0.3",
    "h3": "1.15.5",
    "hookable": "6.1.1",
    "iron-webcrypto": "2.0.0",
    "node-mock-http": "1.0.4",
    "radix3": "1.1.2",
    "source-map-js": "1.2.1",
    "tesseract.js": "^7.0.0",
    "ufo": "1.6.3",
    "uncrypto": "0.1.3",
    "unhead": "2.1.9",
    "vue": "3.5.33",
    "vue-bundle-renderer": "2.2.0",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@iconify-json/circle-flags": "^1.2.10",
    "@iconify-json/lucide": "^1.2.104",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/icon": "^2.2.1",
    "@nuxt/ui": "^4.7.1",
    "@nuxtjs/i18n": "^10.3.0",
    "@playwright/test": "^1.59.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.12.2",
    "@vitest/coverage-v8": "4.1.5",
    "@vueuse/core": "^14.2.1",
    "agentation-vue3": "^1.0.4",
    "electron": "^39.7.0",
    "electron-builder": "^26.8.1",
    "es-toolkit": "^1.46.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "fallow": "^2.59.0",
    "fast-png": "^8.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "nuxt": "^4.4.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.4.624",
    "playwright": "^1.59.1",
    "puppeteer-core": "^24.42.0",
    "sass-embedded": "^1.99.0",
    "stylelint": "^17.9.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "type-coverage": "^2.29.7",
    "type-fest": "^5.6.0",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^21.0.0",
    "utif": "^3.1.0",
    "vitest": "^4.1.5",
    "vue-eslint-parser": "10.4.0",
    "vue-tsc": "3.2.7"
  },
  "packageManager": "pnpm@10.32.1"
}
