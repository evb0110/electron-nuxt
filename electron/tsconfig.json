{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "strict": true,
        "noEmit": true,
        "noImplicitReturns": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedIndexedAccess": true,
        "useUnknownInCatchVariables": true,
        "strictBuiltinIteratorReturn": true,
        "verbatimModuleSyntax": true,
        "moduleDetection": "force",
        "isolatedModules": true,
        "forceConsistentCasingInFileNames": true,
        "baseUrl": "..",
        "paths": {
            "@contracts": ["packages/contracts/index.ts"],
            "@contracts/*": ["packages/contracts/*"],
            "@pdf-core": ["packages/pdf-core/index.ts"],
            "@pdf-core/*": ["packages/pdf-core/*"],
            "@electron-worker-bundles/*": ["packages/electron-worker-bundles/*"],
            "@electron/*": ["electron/*"],
            "@i18n-core": ["packages/i18n-core/index.ts"],
            "@i18n-core/*": ["packages/i18n-core/*"],
            "@i18n-app": ["packages/i18n-app/index.ts"],
            "@i18n-app/*": ["packages/i18n-app/*"],
            "@releaseSelection": ["packages/release-selection/index.ts"],
            "@releaseSelection/*": ["packages/release-selection/*"],
            "@scripts/*": ["scripts/*"],
            "@server/*": ["server/*"],
            "@tests/*": ["tests/*"]
        },
        "types": ["node"]
    },
    "include": [
        "./**/*.ts",
        "./**/*.d.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}
