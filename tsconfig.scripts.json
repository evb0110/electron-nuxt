{
    "extends": "./electron/tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "skipLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "@app/*": ["app/*"],
            "@contracts": ["packages/contracts/index.ts"],
            "@contracts/*": ["packages/contracts/*"],
            "@electron/*": ["electron/*"],
            "@i18n-core": ["packages/i18n-core/index.ts"],
            "@i18n-core/*": ["packages/i18n-core/*"],
            "@release-selection": ["packages/release-selection/index.ts"],
            "@release-selection/*": ["packages/release-selection/*"]
        }
    },
    "include": [
        "scripts/**/*.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}
