{
    "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
    "entry": [
        "app/app.vue",
        "app/app.config.ts",
        "app/pages/**/*.vue",
        "app/components/**/*.vue",
        "app/plugins/**/*.ts",
        "app/composables/**/*.ts",
        "app/utils/**/*.ts",
        "app/constants/**/*.ts",
        "app/i18n/**/*.ts",
        "server/**/*.ts",
        "electron/main.ts",
        "electron/preload.ts",
        "electron/image/pdf-combine-worker.ts",
        "electron/features/documents/main/pdf-conformance-worker.ts",
        "electron/features/djvu/main/pdf-worker.ts",
        "electron/features/image-export/main/tiff-combine-worker.ts",
        "electron/features/page-ops/main/crop-worker.ts",
        "electron/ocr/worker/main.ts",
        "electron/search/worker.ts",
        "packages/*/index.ts",
        "scripts/**/*.{ts,mjs,cjs}"
    ],
    "ignorePatterns": [
        "app/types/*.d.ts",
        "electron/types/semver.d.ts",
        "electron/types/utif.d.ts",
        "electron/djvu/conversion.ts",
        "electron/djvu/convert.ts",
        "electron/image/export.ts",
        "electron/ipc/dialogs.ts",
        "electron/ipc/fileOps.ts",
        "electron/ipc/pdfExport.ts",
        "app/assets/css/*.scss",
        "landing/**",
        "nuxt-output/**",
        "public/**"
    ],
    "ignoreDependencies": [
        "@iconify-json/circle-flags",
        "@iconify-json/lucide",
        "@iconify/utils",
        "@intlify/core",
        "@intlify/core-base",
        "@intlify/h3",
        "@intlify/message-compiler",
        "@intlify/shared",
        "@intlify/utils",
        "@vue/compiler-core",
        "@vue/compiler-ssr",
        "@vue/devtools-api",
        "@vue/reactivity",
        "@vue/runtime-core",
        "@vue/runtime-dom",
        "@vue/server-renderer",
        "@vue/shared",
        "consola",
        "cookie-es",
        "defu",
        "devalue",
        "entities",
        "estree-walker",
        "eslint-import-resolver-typescript",
        "eslint-plugin-import",
        "hookable",
        "iron-webcrypto",
        "node-mock-http",
        "@playwright/test",
        "radix3",
        "sass-embedded",
        "source-map-js",
        "type-coverage",
        "ufo",
        "uncrypto",
        "unhead",
        "vue-bundle-renderer"
    ],
    "workspaces": {
        "patterns": [
            "packages/*"
        ]
    },
    "duplicates": {
        "ignoreImports": true,
        "minLines": 8,
        "minTokens": 80,
        "threshold": 10
    },
    "health": {
        "ignore": [
            "app/assets/css/vendor/**",
            "public/**",
            "tests/**"
        ]
    },
    "rules": {
        "unused-dev-dependencies": "error",
        "unused-optional-dependencies": "error",
        "duplicate-exports": "warn",
        "type-only-dependencies": "warn",
        "test-only-dependencies": "warn"
    }
}
