{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "baseUrl": ".",
        "paths": {
            "@evb/contracts": ["../../packages/contracts/index.ts"],
            "@evb/contracts/*": ["../../packages/contracts/*"],
            "@i18n-core": ["../../packages/i18n-core/index.ts"]
        }
    },
    "include": [
        "App.tsx",
        "index.ts",
        "src/**/*.ts",
        "src/**/*.tsx"
    ]
}
